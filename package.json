{
  "name": "triple_g.casa",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "scss": "sass web/themes/custom/triple_g/src/scss/main.scss web/themes/custom/triple_g/css/triple_g.css",
    "scss:min": "sass web/themes/custom/triple_g/src/scss/main.scss web/themes/custom/triple_g/css/triple_g.min.css --style=compressed --no-source-map",
    "build:sass": "node scripts/build-sass.mjs",
    "watch:tokens": "sass --watch web/themes/custom/triple_g/src/scss/theme-tokens.scss:web/themes/custom/triple_g/css/theme-tokens.css --no-source-map",
    "watch:sdc": "sass --watch web/themes/custom/triple_g/components/:web/themes/custom/triple_g/components/ --no-source-map",
    "postcss": "postcss web/themes/custom/triple_g/css/triple_g.min.css -o web/themes/custom/triple_g/css/triple_g.post.min.css",
    "minify:css": "css-minify -f web/themes/custom/triple_g/css/triple_g.post.min.css -o web/themes/custom/triple_g/css/",
    "clean:css": "rm web/themes/custom/triple_g/css/triple_g.css web/themes/custom/triple_g/css/triple_g.post.min.css",
    "build:css": "npm-run-all build:sass",
    "watch:css": "npm-run-all --parallel watch:tokens watch:sdc",
    "watch:scss:postcss": "sass --watch web/themes/custom/triple_g/src/scss/main.scss:web/themes/custom/triple_g/css/triple_g.min.css --style=compressed --no-source-map & postcss --watch web/themes/custom/triple_g/css/triple_g.min.css -o web/themes/custom/triple_g/css/triple_g.post.min.css",
    "concat:js": "find web/themes/custom/triple_g/src/js -name '*.js' | xargs concat -o web/themes/custom/triple_g/js/triple_g.js",
    "minify:js": "terser web/themes/custom/triple_g/js/triple_g.js -o web/themes/custom/triple_g/js/triple_g.min.js --compress --mangle",
    "clean:js": "rm web/themes/custom/triple_g/js/triple_g.js",
    "build:js": "npm-run-all concat:js minify:js clean:js",
    "watch:js": "while true; do find web/themes/custom/triple_g/src/js -name '*.js' | xargs concat -o web/themes/custom/triple_g/js/triple_g.js; sleep 2; done",
    "browser-sync": "browser-sync start --proxy 'triple-g.local:8080' --files 'web/themes/custom/triple_g/css/*.css, web/themes/custom/triple_g/components/**/*.css, web/themes/custom/triple_g/js/*.min.js, web/themes/custom/triple_g/templates/**/*.twig, web/themes/custom/triple_g/**/*.php' --no-open --no-notify --no-ghost-mode --reload-delay 300",
    "lint:css": "stylelint 'components/**/*.css' 'src/scss/**/*.scss'",
    "lint:js": "eslint 'components/**/*.js'",
    "lint": "npm run lint:css && npm run lint:js",
    "build": "npm-run-all build:css build:js",
    "watch": "npm-run-all -p watch:css watch:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omsclls/triple_g.casa.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omsclls/triple_g.casa/issues"
  },
  "homepage": "https://github.com/omsclls/triple_g.casa#readme",
  "description": "",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "autoprefixer": "^10.4.19",
    "browser-sync": "^3.0.4",
    "concat": "^1.0.3",
    "css-minify": "^2.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drupal": "^0.3.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^10.1.0",
    "sass": "^1.89.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "terser": "^5.43.1"
  },
  "dependencies": {
    "help": "^3.0.2"
  }
}
