# Montreal 2027 WorldCon - Environment Configuration
#
# This file is OPTIONAL. The docker-compose.yml already includes these defaults.
# Only create a .env file if you need to override the default values.
#
# To use: Copy this file to .env and customize the values you want to change.

# Web server ports (host -> container)
# Default: localhost:8081 -> container:80
# Docker Only
WEB_EXTERNAL_PORT=8081
WEB_INTERNAL_PORT=80

# Host path mounted at /var/www/html. Set this to the physical checkout path
# when using Colima with a project stored on an external volume.
HOST_PROJECT_ROOT=/Volumes/MacDaddyPro/Projects/Sites/triple-g.dev

# Database connectivity
# Defaults: drupal/drupal/drupal
# Local and Docker, always use 'db' as the hostname for Docker
DB_HOST=db
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=root

# Container names (defaults shown)
# Docker Only
WEB_CONTAINER_NAME=tripleg-web
DB_CONTAINER_NAME=tripleg-db

# Persistent volume and network names (defaults shown)
# Docker Only
DB_VOLUME_NAME=tripleg_db_data
FRONTEND_NETWORK_NAME=tripleg_frontend
BACKEND_NETWORK_NAME=tripleg_backend

# PHP version (default: 8.5, required by this project)
# Docker only
PHP_VERSION=8.5

# MariaDB version (default: 11.4)
# Docker only
MARIADB_VERSION=11.4

# Valkey version (default: 8-alpine)
# Docker only
VALKEY_VERSION=8-alpine
VALKEY_HOST=valkey
VALKEY_PORT=6379
# Use a unique prefix per environment if Valkey is shared (for example, triple_g_stg_).
VALKEY_CACHE_PREFIX=dev_3G_

# Hash Salt (default for development: RandomHashSaltForDevelopmentPurposesOnly)
# IMPORTANT: Generate a unique random string for production!
# Use: docker-compose exec web drush eval "echo \Drupal\Component\Utility\Crypt::randomBytesBase64(55)"
# Local and Docker
HASH_SALT=ChangeThisToARandomStringForProduction

# Set this to 'native' or 'docker' based on the current laptop's stack.
# This is used by the AI agent configuration and scripts/sync.sh
APP_ENV_TYPE=docker

# Production sync settings (for scripts/sync.sh)
# These are used to synchronize files and database from production to local
# Local and Docker
# Set to true when production is available locally; no SSH is used.
SYNC_LOCAL=false
# Local production checkout used when SYNC_LOCAL=true.
SYNC_PROD_ROOT=/home/cansmof/prod.montreal2027.ca
SYNC_HOST=montreal2027.ca
SYNC_USER=www-data
SYNC_REMOTE_ROOT=/var/www/montreal2027.ca/
SYNC_SSH_KEY=~/.ssh/montreal2027
SYNC_SSH_PORT=345
SYNC_BACKUP_DIR=../backups
