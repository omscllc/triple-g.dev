# Web server ports (host -> container)
# Default: localhost:8080 -> container:80
# Docker Only
WEB_EXTERNAL_PORT=8080
WEB_INTERNAL_PORT=80
HOST_PROJECT_ROOT=/path/to/your/project/root

# Database connectivity
# Defaults: drupal/drupal/drupal
# Local and Docker, always use 'db' as the hostname for Docker
DB_HOST=db
DB_PORT=3306
DB_NAME=drupal_db_name
DB_USER=drupal_db_user
DB_PASSWORD=drupal_db_password
DB_ROOT_PASSWORD=your_root_password

# Container names (defaults shown)
# Docker Only
WEB_CONTAINER_NAME=web-container-name
DB_CONTAINER_NAME=db-container-name

# Persistent volume and network names (defaults shown)
# Docker Only
DB_VOLUME_NAME=db-volume-name
FRONTEND_NETWORK_NAME=frontend-network-name
BACKEND_NETWORK_NAME=backend-network-name

# PHP version (default: 8.3, recommended for Drupal 11)
# Docker only
PHP_VERSION=8.4

# MariaDB version (default: 11.4)
# Docker only
MARIADB_VERSION=11.4

# Hash Salt (default for development: RandomHashSaltForDevelopmentPurposesOnly)
# IMPORTANT: Generate a unique random string for production!
# Use: docker-compose exec web drush eval "echo \Drupal\Component\Utility\Crypt::randomBytesBase64(55)"
# Local and Docker
HASH_SALT=your_unique_hash_salt_here

# Set this to 'native' or 'docker' based on the current laptop's stack.
# This is used by the AI agent configuration and scripts/sync.sh
APP_ENV_TYPE=docker

# Cache prefix to use
CACHE_PREFIX=cache_prefix_

# Production sync settings (for scripts/sync.sh)
# These are used to synchronize files and database from production to local

# Set to true when production is available locally; no SSH is used.
SYNC_LOCAL=false

# Local production root used when SYNC_LOCAL=true.
SYNC_PROD_ROOT=/path/to/local/production/root

# Host to sync to
SYNC_HOST=your.production.host.com

# User to login as
SYNC_USER=sync-user

# Remote production root
SYNC_REMOTE_ROOT=/path/to/remote/production/root

# SSH key to use
SYNC_SSH_KEY=~/.ssh/your_ssh_key

# What port to use
SYNC_SSH_PORT=22

# Directory path for backing up the local db
SYNC_BACKUP_DIR=../backup_directory

# Prefix the backup file with this
BU_FILE_PREFIX=backup-prefix

# Path to PHP
PHP_PATH=/usr/bin/php
