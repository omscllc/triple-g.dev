{% embed 'triple_g:blog-post' with {} %}
  {% block title %}
    {{ title_prefix }}
    <h1{{ title_attributes.addClass('blog-post__title') }}>{{ label }}</h1>
    {{ title_suffix }}
  {% endblock %}
  {% block authored_on %}{{ date }}{% endblock %}
  {% block tags %}
    {% if content.field_tags is iterable %}
      {% for item in content.field_tags|filter(item => item['#type'] is defined) %}
        {{ item }}
      {% endfor %}
    {% endif %}
  {% endblock %}
  {% block body %}{{ content.body }}{% endblock %}
{% endembed %}
  {{ content|without('created', 'body', 'field_tags') }}
