<header class="site-shell__header" role="banner">
  <div class="site-shell__header-inner">
    <a class="site-shell__branding" href="{{ front_page }}" rel="home">
      <img src="{{ base_path }}assets/triple-g-logo.png" alt="{{ 'Geek’s Gadgets and Gizmos'|t }}">
    </a>
    {% if page.branding %}
      <div class="site-shell__brand-name">{{ page.branding }}</div>
    {% endif %}
    <div class="site-shell__navigation">
      {% if page.primary_menu %}
        {{ page.primary_menu }}
      {% endif %}
      <nav class="site-shell__search-navigation" aria-label="{{ 'Search'|t }}">
        <a class="site-shell__search-link" href="{{ base_path }}search">{{ 'Search'|t }}</a>
      </nav>
      {{ include('triple_g:search-form', {
        action: base_path ~ 'search',
        input_id: 'site-header-search',
        attributes: create_attribute({class: ['site-shell__search']}),
      }, with_context: false) }}
      <ul class="site-shell__theme-menu">
        <li>
          <button class="site-shell__theme-toggle" type="button" data-color-mode-toggle data-color-mode-target="light" aria-label="{{ 'Light mode'|t }}" data-tooltip="{{ 'Light mode'|t }}">
            <img class="site-shell__theme-icon site-shell__theme-icon--light" src="{{ base_path }}assets/triple-g-icon-bulb-on.png" alt="" width="28" height="28">
            <img class="site-shell__theme-icon site-shell__theme-icon--dark" src="{{ base_path }}assets/triple-g-icon-bulb-off.png" alt="" width="28" height="28">
          </button>
        </li>
      </ul>
    </div>
    {% if page.secondary_menu %}
    <div class="site-shell__account">
      {{ page.secondary_menu }}
    </div>
    {% endif %}
  </div>
</header>
