{% embed 'triple_g:site-shell' with {} %}
  {% block header %}
  {{ include('@triple_g/templates/layout/page-header.html.twig') }}
  {% endblock %}
  {% block highlighted %}{{ page.highlighted }}{% endblock %}
  {% block help %}{{ page.help }}{% endblock %}
  {% block content %}
    {% if not is_front %}
      {# Blog posts render their own h1 inside the article, so omit the page title block. #}
      {{ node.bundle == 'blog_post' ? page.header|without('triple_g_page_title') : page.header }}
    {% endif %}
    <div class="site-shell__columns">
      {% if page.sidebar_first %}
        <aside class="site-shell__sidebar" aria-label="{{ 'Blog sidebar'|t }}">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}
      <div class="site-shell__content">
        {{ page.content }}
      </div>
    </div>
  {% endblock %}
  {% block footer %}
    {{ include('@triple_g/templates/layout/page-footer.html.twig') }}
  {% endblock %}
{% endembed %}
