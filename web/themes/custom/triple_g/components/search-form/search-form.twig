<form{{ attributes.addClass('search-form') }} action="{{ action }}" method="get" role="search">
  <label class="visually-hidden" for="{{ input_id }}">{{ 'Search the site'|t }}</label>
  <input id="{{ input_id }}" class="search-form__input" type="search" name="q" placeholder="{{ 'Search'|t }}">
  <button class="search-form__submit" type="submit" aria-label="{{ 'Search'|t }}">
    <svg class="search-form__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <circle cx="10.8" cy="10.8" r="6.3"></circle>
      <path d="m15.5 15.5 5 5"></path>
    </svg>
  </button>
</form>
