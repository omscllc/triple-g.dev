<article{{ attributes.addClass('blog-post') }}>
  <header class="blog-post__header">
    <div class="blog-post__heading">{% block title %}{% endblock %}</div>
    <div class="blog-post__date">{% block authored_on %}{% endblock %}</div>
  </header>
  <div class="blog-post__body">{% block body %}{% endblock %}</div>
</article>
